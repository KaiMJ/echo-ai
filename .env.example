# Machine-specific paths and secrets only.
# Choose a model with /model in Echo; defaults are saved in SQLite.
# This is the Hugging Face HUB directory, containing models--* and shared blobs/.
ECHO_HF_HUB_CACHE=/path/to/.cache/huggingface/hub
ECHO_INFERENCE_PORT=8001

# Only needed if Gemma was downloaded to a different hub directory.
# ECHO_GEMMA_HUB_CACHE=/other/path/to/.cache/huggingface/hub

# Optional credentials and state location. Model profiles name their key variable.
# ECHO_API_KEY=local
# XAI_API_KEY=your-xai-api-key
# ECHO_STATE_DIR=~/.local/share/echo-ai

# Optional standalone Google example (see docs/development/google-tools-example.md).
# The token file is generated after browser consent; do not create it manually.
# GOOGLE_CREDENTIALS_FILE=~/.config/echo-ai/google/credentials.json
# GOOGLE_TOKEN_FILE=~/.local/share/echo-ai/google/token.json

# Optional Cloudflare Pages deployment (loaded by frontend's deploy command).
# CLOUDFLARE_API_TOKEN=your-api-token
# CLOUDFLARE_ACCOUNT_ID=your-account-id
