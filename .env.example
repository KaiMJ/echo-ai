# Copy to .env. Both echo-ai and root-level Docker Compose read it.
# Exported environment variables take precedence. Do not commit .env.

# Local inference: set the complete cache directory, not its snapshots subdirectory.
ECHO_MODEL_CACHE=/path/to/models--cyankiwi--gemma-4-26B-A4B-it-AWQ-4bit
ECHO_MODEL_REVISION=3a7dcb639a4e7b230a0491ab4fa6fac081284d37
ECHO_MODEL=cyankiwi/gemma-4-26B-A4B-it-AWQ-4bit
ECHO_INFERENCE_PORT=8001
ECHO_PIPELINE_PARALLEL_SIZE=2
ECHO_TENSOR_PARALLEL_SIZE=1
ECHO_GPU_MEMORY_UTILIZATION=0.90
ECHO_MAX_NUM_SEQS=4

# Total context includes input AND output. Redeploy inference after changing this.
# The pinned Gemma checkpoint declares a 262,144-token native context window.
ECHO_CONTEXT_TOKENS=262144
ECHO_MAX_TOKENS=16384
# Optional additional character cap; otherwise derived from context/output settings.
# ECHO_MAX_CONTEXT_CHARS=32000

# New-session agent settings.
ECHO_MAX_STEPS=20
ECHO_TIMEOUT=180
ECHO_TEMPERATURE=1.0
ECHO_TOP_P=0.95
ECHO_TOP_K=64

# Optional: defaults to localhost and ECHO_INFERENCE_PORT.
# ECHO_BASE_URL=http://127.0.0.1:8001/v1
# ECHO_API_KEY=local
# ECHO_STATE_DIR=~/.local/share/echo-ai
